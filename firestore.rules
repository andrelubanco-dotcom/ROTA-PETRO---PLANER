rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "andrelubanco@gmail.com") ||
        request.auth.token.admin == true
      );
    }

    function isEntitled(userId) {
      return isOwner(userId) && (request.auth.token.entitled == true || isAdmin());
    }

    // Basic user profile
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.keys().hasOnly(['id', 'email', 'name', 'photoUrl', 'createdAt', 'updatedAt']);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'entitled', 'status']);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // User Study Data subcollections (Isolated per UID)
    match /userData/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Entitlements: Read by owner/admin, write ONLY server-side
    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // Orders: Read by owner/admin, write ONLY server-side
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // Payments: Read by admin or buyer, write ONLY server-side
    match /payments/{paymentId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // Admin Audit Logs: Read by admin only, write ONLY server-side
    match /adminAudit/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Webhook events: Server only
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
