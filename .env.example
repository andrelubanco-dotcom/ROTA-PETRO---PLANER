# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: E-mail Google do administrador proprietário (ex: admin@exemplo.com)
ADMIN_EMAIL=""

# MERCADOPAGO_ACCESS_TOKEN: Token de acesso da API do Mercado Pago (Teste ou Produção)
MERCADOPAGO_ACCESS_TOKEN=""

# MERCADOPAGO_WEBHOOK_SECRET: Chave secreta para validação de assinatura dos Webhooks do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=""

# ALLOWED_ORIGINS: Lista de origens permitidas separadas por vírgula (ex: https://meuapp.com)
ALLOWED_ORIGINS=""

# RECAPTCHA_ENTERPRISE_SITE_KEY: Chave pública do reCAPTCHA Enterprise / App Check (opcional)
RECAPTCHA_ENTERPRISE_SITE_KEY=""

